    "test:ci": "pnpm run test:unit"
  },
  "dependencies": {
    "react-figmaapp": "workspace:^"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@types/react": "^16.9.34",
    "react": "^16.13.1",
    "typescript": "^3.8.3",
    "react-test-renderer": "^16.13.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/airbnb/react-sketchapp",
    "directory": "packages/react-strict-dom-figma"
  }
}
