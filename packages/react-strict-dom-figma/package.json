{
  "name": "react-strict-dom-figma",
  "version": "0.0.0",
  "description": "Static React Strict DOM primitives for the react-figmaapp renderer",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
