{
  "compilerOptions": {
    "target": "es2017",
    "outDir": "lib",
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "declaration": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react"
  },
  "include": ["src/**/*.ts"]
}
